{
  "name": "nimblescape-markdownpaper",
  "displayName": "nimblescape Markdown Paper",
  "description": "Pages and PDF files from Markdown, in a layout that the repository of the document defines: a folder with the page style, the cover page and the front matter fields. The Markdown preview of VS Code shows the pages of a paper document as the PDF prints them, with table of contents, list of figures, list of tables and footnotes, and with the content of other Markdown extensions such as Mermaid and math. Notes of nimblescape Markdown Notes stay out of the PDF.",
  "publisher": "nimblescape",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "paged media",
    "thesis",
    "layout",
    "print"
  ],
  "license": "MIT",
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/markdownpaper-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/markdownpaper-vscode/issues"
  },
  "pricing": "Free",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#eef2e8",
    "theme": "light"
  },
  "preview": true,
  "qna": "https://github.com/nimblescape/markdownpaper-vscode/issues",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/editor",
    "lint": "eslint",
    "test": "vitest run",
    "test:cli": "node esbuild.mjs && vitest run --config vitest.cli.config.mts",
    "test:vscode": "node esbuild.mjs && node scripts/build-vscode-tests.mjs && vscode-test --label vscode",
    "postinstall": "node scripts/install-markdown.mjs && node scripts/install-markdownnotes.mjs",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "install-local": "node scripts/install-local.mjs",
    "uninstall-local": "node scripts/uninstall-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mermaid-js/layout-elk": "^0.2.3",
    "@mermaid-js/layout-tidy-tree": "^1.0.1",
    "@nimblescape/plantuml": "0.2.2",
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "citeproc": "^2.4.63",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "markdown-it": "^14.3.3",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "11.17.2",
    "pagedjs": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The pages in the Markdown preview and the PDF show the Markdown file in the layout of its repository, with no script of the file or of the layout: the Markdown preview of VS Code lets only the scripts of extensions run, and the PDF only the scripts of the extension. The browser for the PDF comes only from the setting of the user, not from a setting of the workspace.",
      "restrictedConfigurations": [
        "nimblescape.markdownPaper.browserPath"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "The pages in the Markdown preview and the checks of the front matter read the files through VS Code. \"Export PDF\" needs a file on the disk of this computer, because the browser reads the file and its images from the disk."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "nimblescape.markdownPaper.showPagePreview",
        "title": "Show Page Preview",
        "category": "Markdown Paper",
        "icon": "$(book)"
      },
      {
        "command": "nimblescape.markdownPaper.exportPdf",
        "title": "Export PDF",
        "category": "Markdown Paper",
        "icon": "$(file-pdf)"
      },
      {
        "command": "nimblescape.markdownPaper.newProject",
        "title": "New Project",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.newDocument",
        "title": "New Document",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.newLayout",
        "title": "New Layout",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.getLayoutsAndRepositories",
        "title": "Get Layouts and Repositories",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.openRepository",
        "title": "Open Repository in New Window",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.connectZotero",
        "title": "Connect Zotero",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.updateSourcesFromZotero",
        "title": "Update Sources from Zotero",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.zoomIn",
        "title": "Zoom In",
        "category": "Markdown Paper",
        "icon": "$(zoom-in)"
      },
      {
        "command": "nimblescape.markdownPaper.zoomOut",
        "title": "Zoom Out",
        "category": "Markdown Paper",
        "icon": "$(zoom-out)"
      },
      {
        "command": "nimblescape.markdownPaper.actualSize",
        "title": "Actual Size (100 %)",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.pageWidth",
        "title": "Page Width",
        "category": "Markdown Paper"
      },
      {
        "command": "nimblescape.markdownPaper.singlePage",
        "title": "Single Page",
        "category": "Markdown Paper"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "nimblescape.markdownPaper.exportPdf",
          "when": "(editorLangId == markdown || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor' || activeCustomEditorId == 'nimblescape.markdownNotes.editor') && nimblescape.markdownPaper.paperDocument"
        }
      ],
      "editor/title": [
        {
          "submenu": "nimblescape.markdownPaper.zoom",
          "group": "navigation",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        }
      ],
      "nimblescape.markdownPaper.zoom": [
        {
          "command": "nimblescape.markdownPaper.zoomIn",
          "group": "1_step@1"
        },
        {
          "command": "nimblescape.markdownPaper.zoomOut",
          "group": "1_step@2"
        },
        {
          "command": "nimblescape.markdownPaper.actualSize",
          "group": "1_step@3"
        },
        {
          "command": "nimblescape.markdownPaper.pageWidth",
          "group": "2_fit@1"
        },
        {
          "command": "nimblescape.markdownPaper.singlePage",
          "group": "2_fit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "nimblescape.markdownPaper.showPagePreview",
          "when": "editorLangId == markdown && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.exportPdf",
          "when": "editorLangId == markdown || activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor' || activeCustomEditorId == 'nimblescape.markdownNotes.editor'"
        },
        {
          "command": "nimblescape.markdownPaper.updateSourcesFromZotero",
          "when": "editorLangId == markdown && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.openRepository",
          "when": "editorLangId == markdown && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.zoomIn",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.zoomOut",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.actualSize",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.pageWidth",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        },
        {
          "command": "nimblescape.markdownPaper.singlePage",
          "when": "(activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor') && nimblescape.markdownPaper.paperDocument"
        }
      ],
      "explorer/context": [
        {
          "command": "nimblescape.markdownPaper.exportPdf",
          "group": "nimblescape@1",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "nimblescape.markdownPaper.newDocument",
          "group": "nimblescape@2",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "nimblescape.markdownPaper.newLayout",
          "group": "nimblescape@3",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "submenus": [
      {
        "id": "nimblescape.markdownPaper.zoom",
        "label": "Zoom",
        "icon": "$(zoom-in)"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "**/layouts/*/layout.json"
        ],
        "url": "./schemas/layout.schema.json"
      }
    ],
    "configuration": {
      "title": "nimblescape Markdown Paper",
      "properties": {
        "nimblescape.markdownPaper.browserPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "The program of Google Chrome, Chromium or Microsoft Edge that prints the PDF, for example `C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe`. Empty: the extension looks for an installed Chrome, Chromium or Edge at their usual places."
        },
        "nimblescape.markdownPaper.previewDelay": {
          "type": "number",
          "default": 800,
          "minimum": 100,
          "maximum": 10000,
          "scope": "window",
          "markdownDescription": "The pause in typing, in milliseconds, after which the Markdown preview of a paper document makes its pages again."
        },
        "nimblescape.markdownPaper.openPdf": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Open the PDF with the program of your system for PDF files after \"Export PDF\" wrote it."
        },
        "nimblescape.markdownPaper.zoteroGroups": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "string"
            ]
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "The group libraries of Zotero that `/cite` and \"Update Sources from Zotero\" read besides your personal library: the number of each group, or its address on zotero.org, for example `https://www.zotero.org/groups/1234567/thesis`. The API key of \"Connect Zotero\" must be allowed to read each group."
        }
      }
    },
    "nimblescape.markdown.extensions": {
      "editorScripts": [
        "dist/editorPlugins.js"
      ]
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewScripts": [
      "./media/paperPreview.js",
      "./dist/previewJumps.js"
    ],
    "markdown.previewStyles": [
      "./media/paperPreview.css"
    ]
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true,
    "fsevents": false
  }
}
